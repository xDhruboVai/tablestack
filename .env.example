# Contact form delivery options. Copy to .env.local and fill in the values for the provider you use.

# Contact form delivery (https://resend.com). Without these, the form logs submissions in development and shows an error state in production.
RESEND_API_KEY=
# Where inquiries are delivered
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "TableStack <site@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Google Apps Script webhook for contact form delivery.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Work on/off switches (the admin page). Without these, every project stays visible.
# Supabase -> Project Settings -> API. Use the project URL and a safe project key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Credentials for the admin screen at /admin.
WORK_ADMIN_USERNAME=
WORK_ADMIN_PASSWORD=
