# Contact form delivery options. Copy to .env.local and fill in the values for the provider you use.

# Contact form delivery (https://resend.com). Without these, the form logs submissions in development and shows an error state in production.
RESEND_API_KEY=
# Where inquiries are delivered
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "TableStack <site@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Google Apps Script webhook for contact form delivery.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Supabase: the work on/off switches (the admin page) and a second copy of every contact inquiry (the
# `inquiries` table). Without these, every project stays visible and inquiries go to Google Sheets only.
# Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
# Secret. Server only, never shared. The site uses it to save the switches; with the table's access rules
# on (supabase/migrations/*_project_visibility_rls.sql) it is the only key that can change them.
SUPABASE_SERVICE_ROLE_KEY=
# Public key. Only a fallback for reading the switches when the secret key is not set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The address of the admin screen. Set it to something nobody would guess, for example a few random words
# joined by dashes (letters, numbers and dashes only, at least 3 characters). The screen is then at
# https://your-site/<that value>, and /admin shows the normal "page not found". Unset = the address built into
# lib/visibility.ts.
# Don't link to it anywhere and don't put it in the code.
WORK_ADMIN_PATH=
# Credentials for the admin screen. Use a long password that is not used anywhere else.
# Changing either one signs everyone out.
WORK_ADMIN_USERNAME=
WORK_ADMIN_PASSWORD=
