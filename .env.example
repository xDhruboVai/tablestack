# Contact form delivery (https://resend.com). Copy to .env.local and fill in.
# Without these, the form logs submissions in development and shows an error state in production.
RESEND_API_KEY=
# Where inquiries are delivered
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "TableStacks <site@yourdomain.com>"
CONTACT_FROM_EMAIL=
